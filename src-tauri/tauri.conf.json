{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WB-Switch-Plus",
  "version": "0.1.3",
  "identifier": "com.hyact.wb-switch-plus",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WB-Switch-Plus · WorkBuddy 账号切换",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 30
        },
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/agent-studio-runtime"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzQThFRTcxMDk4OEVENkEKUldScTdZZ0pjZTZvb3dFbWZ5U2xhZFRmSG0xNEYrZ2hLeW9hVjJjT3QxbFUwUmgyZnNuTVBLZGQK",
      "endpoints": [
        "https://github.com/Hyact/workbuddy-switch-plus/releases/latest/download/latest.json",
        "https://github.com/Hyact/workbuddy-switch-plus/releases/latest/download/latest-{{target}}-{{arch}}.json",
        "https://github.com/Hyact/workbuddy-switch-plus/releases/latest/download/latest-macos-{{arch}}.json"
      ]
    }
  }
}
